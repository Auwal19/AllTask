public static boolean isMagicSquare(int[][] a) {
    if (a.length == 0) {
        return true;
    }
    
    int n = a.length;
    for (int i = 0; i < n; i++) {
        if (a[i].length != n) {
            return false;
        }
    }
    
    int targetSum = 0;
    for (int j = 0; j < n; j++) {
        targetSum += a[0][j];
    }
    
    
    for (int i = 1; i < n; i++) {
        int rowSum = 0;
        for (int j = 0; j < n; j++) {
            rowSum += a[i][j];
        }
        if (rowSum != targetSum) return false;
    }
    
    
    for (int j = 0; j < n; j++) {
        int colSum = 0;
        for (int i = 0; i < n; i++) {
            colSum += a[i][j];
        }
        if (colSum != targetSum) return false;
    }
    
    
    int diag1 = 0;
    for (int i = 0; i < n; i++) {
        diag1 += a[i][i];
    }
    if (diag1 != targetSum) return false;
    
    
    int diag2 = 0;
    for (int i = 0; i < n; i++) {
        diag2 += a[i][n - 1 - i];
    }
    
    return diag2 == targetSum;
}